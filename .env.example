# ---------- App ----------
# MySQL on Coolify.
#  - Production (inside Coolify): the database's "MySQL URL (internal)"
#  - Local dev: the database's public URL (temporarily enabled public access)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/default"
APP_URL="https://pay.example.com"        # Public URL (used for webhook + redirect URLs)
ADMIN_PASSWORD="change-me"               # Dashboard login password
SESSION_SECRET="long-random-string"      # Used to sign the session cookie
CRON_SECRET="another-random-string"      # Protects /api/cron/refresh

# ---------- Ziina ----------
ZIINA_API_TOKEN=""                        # From ziina.com/business/connect (scope: write_payment_intents)
ZIINA_WEBHOOK_SECRET="random-hmac-secret" # Sent to Ziina when registering the webhook
ZIINA_TEST_MODE="true"                    # "true" creates test payment intents
ZIINA_CURRENCY="AED"

# ---------- Zoho Books ----------
ZOHO_DC="com"                             # com | eu | in | com.au | jp | ca | sa
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
ZOHO_ORG_ID=""
