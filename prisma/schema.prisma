generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Payment {
  id             String    @id @default(cuid())
  ziinaIntentId  String    @unique @db.VarChar(100)
  amountFils     Int
  currency       String    @default("AED") @db.VarChar(10)
  message        String?   @db.Text
  status         String    @default("requires_payment_instrument") @db.VarChar(40)
  redirectUrl    String?   @db.Text
  operationId    String?   @db.VarChar(100)
  feeFils        Int       @default(0)
  tipFils        Int       @default(0)
  settledFils    Int?
  // What the customer paid in their own currency (e.g. 170.90 SAR); amountFils is always the settled AED amount.
  originalAmountFils Int?
  originalCurrency   String?   @db.VarChar(10)
  paidAt         DateTime?
  cardBrand      String?   @db.VarChar(40)
  cardLast4      String?   @db.VarChar(8)
  lastErrorZiina String?   @db.Text

  customerName  String? @db.VarChar(200)
  customerEmail String? @db.VarChar(200)
  customerPhone String? @db.VarChar(40)
  notes         String? @db.Text
  orderNumber   String? @db.VarChar(40) // Ziina app order number (entered manually; not exposed by the Ziina API)

  source   String  @default("api") @db.VarChar(20) // api | csv | webhook
  test     Boolean @default(false)
  archived Boolean @default(false) // hidden from lists, totals and Zoho checks (e.g. test payments)

  // Partner entitled to this payment (accounting: partner statements)
  partnerAccountId String?
  partner          LedgerAccount? @relation(fields: [partnerAccountId], references: [id], onDelete: SetNull)

  // Zoho Books
  zohoStatus        String    @default("not_synced") @db.VarChar(20) // not_synced | contact_ready | invoiced | paid | error
  zohoContactId     String?   @db.VarChar(40)
  zohoItemId        String?   @db.VarChar(40)
  zohoItemName      String?   @db.VarChar(255)
  zohoInvoiceId     String?   @db.VarChar(40)
  zohoInvoiceNumber String?   @db.VarChar(60)
  zohoPaymentId     String?   @db.VarChar(40)
  emailSent         Boolean   @default(false)
  lastError         String?   @db.Text
  syncedAt          DateTime?

  // Reconciliation with Zoho (see src/lib/reconcile.ts)
  zohoCheckedAt      DateTime?
  zohoCandidates     String?   @db.Text // JSON: possible matches found by amount/date/customer
  zohoCandidateCount Int       @default(0)
  zohoIgnoredIds     String    @default("") @db.VarChar(2000) // comma-separated Zoho ids the user rejected as matches

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  logs      SyncLog[]

  @@index([status])
  @@index([zohoStatus])
  @@index([createdAt])
  @@index([archived])
  @@index([partnerAccountId])
}

model SyncLog {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  step      String   @db.VarChar(40)
  success   Boolean
  detail    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([paymentId])
}

model Setting {
  key   String @id @db.VarChar(100)
  value String @db.Text
}

// ---------- Simple accounting (see src/lib/ledger.ts) ----------

model LedgerAccount {
  id                   String    @id @default(cuid())
  key                  String?   @unique @db.VarChar(40) // system accounts: ziina, wio, partner_mert, partner_nawras
  name                 String    @db.VarChar(120)
  kind                 String    @db.VarChar(20) // gateway | bank | partner
  openingFils          Int       @default(0)
  openingDate          DateTime?
  statementBalanceFils Int?      // last closing balance read from an imported bank statement
  statementDate        DateTime?
  active               Boolean   @default(true)
  sortOrder            Int       @default(0)
  createdAt            DateTime  @default(now())

  outgoing LedgerEntry[] @relation("fromAccount")
  incoming LedgerEntry[] @relation("toAccount")
  payments Payment[]
}

model LedgerEntry {
  id            String         @id @default(cuid())
  date          DateTime
  kind          String         @db.VarChar(20) // transfer | expense | bank_fee | income
  amountFils    Int            // always positive, AED
  feeFils       Int            @default(0) // fee charged on a transfer (added to bank fees)
  fromAccountId String?
  fromAccount   LedgerAccount? @relation("fromAccount", fields: [fromAccountId], references: [id])
  toAccountId   String?
  toAccount     LedgerAccount? @relation("toAccount", fields: [toAccountId], references: [id])
  category      String?        @db.VarChar(60)
  description   String?        @db.Text
  reference     String?        @db.VarChar(120)
  source        String         @default("manual") @db.VarChar(20) // manual | bank_csv
  externalId    String?        @unique @db.VarChar(80) // dedupe key for imported statement lines
  createdAt     DateTime       @default(now())

  @@index([date])
  @@index([kind])
}
